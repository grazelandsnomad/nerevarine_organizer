# Run with -P on every build (the build_info_header target in CMakeLists.txt):
# writes OUT with the git commit SRC is at, and leaves OUT untouched when the
# commit has not changed, so an unchanged tree recompiles nothing.
#   cmake -DSRC=<source dir> -DOUT=<header> -P build_info.cmake
execute_process(
    COMMAND git -C "${SRC}" describe --always --dirty --abbrev=12
    OUTPUT_VARIABLE sha
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR sha STREQUAL "")
    set(sha "unknown")   # a source tarball: no git
endif()
set(content "// Generated by cmake/build_info.cmake - do not edit.\n#pragma once\n#define NR_GIT_SHA \"${sha}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${content}")
