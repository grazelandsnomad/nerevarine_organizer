# Build outputs
build/
build-*/
bin/
dist/
Testing/
*.o
*.d
*.autogen/

# AppImage tooling extracts (--appimage-extract leaves these behind)
squashfs-root/

# Top-level packaging tarballs
/Nerevarine_Organizer-*.tar.*

# IDE / editor leftovers
*.user
*.swp
*.swo
*~
.vscode/
.idea/
.cache/

# Generated by CMake in-place
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
Makefile
compile_commands.json

# AppImage / Flatpak build outputs
*.AppImage
AppDir/
.flatpak-builder/
build-flatpak/

# Packaging scratch
*.pkg.tar.*
*.src.tar.*
/pkg/
/src/nerevarine-*

# AUR working dirs
packaging/aur/pkg/
packaging/aur/src/
packaging/aur/*.pkg.tar.*
packaging/aur/*.src.tar.*

# Markdown is untracked except the top-level README.md, the release-notes
# changelogs and the user guides README links to (kept on disk, not in version
# control otherwise).
*.md
!/README.md
!docs/release-notes/
!docs/release-notes/*.md
!docs/conflicts.md

# Downloads / modlist state the user runs with
modlist_*.txt
loadorder_*.txt
nerevarine_prefs.ini

# Auto-rotated modlist snapshots (the app keeps the last 5 on disk itself):
#   *.bak.<YYYYMMDD-HHMMSS>  - every save rotates one of these
#   *.good.<YYYYMMDD-HHMMSS> - known-good marker taken on clean exit
#   *.premanualedit          - written before the user hand-edits the file
# None of them belong in version control - they churn on every launch.
modlist_*.txt.bak.*
modlist_*.txt.good.*
modlist_*.txt.premanualedit

# Translation coverage stubs (regenerate with scripts/translation_coverage.sh)
translations/_missing/

# OS cruft
.DS_Store
Thumbs.db

# Per-machine Claude Code settings (permission grants etc.), not shared
.claude/settings.local.json
